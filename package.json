{
  "name": "freelanceflow",
  "private": true,
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install && node scripts/setup-env.js",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "dev": "node scripts/dev.js",
    "seed": "npm --prefix backend run seed -- --reset",
    "test": "npm --prefix backend test",
    "audit": "npm --prefix backend run audit:api",
    "build": "npm --prefix frontend run build"
  }
}
