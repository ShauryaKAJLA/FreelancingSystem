{
  "name": "freelanceflow-backend",
  "version": "0.9.0",
  "description": "FreelanceFlow REST API (Express + MongoDB)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/utils/seed.js",
    "test": "node --test tests/*.test.js",
    "create-admin": "node src/utils/createAdmin.js",
    "audit:api": "node scripts/audit-routes.js",
    "explain:lists": "node scripts/explain-lists.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "preflight": "node scripts/preflight.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "mongodb-memory-server": "^10.1.2"
  }
}
