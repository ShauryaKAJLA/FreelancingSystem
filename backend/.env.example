PORT=
NODE_ENV=
# Production requires ALL of: MONGODB_URI (non-local), JWT_SECRET (32+ chars), RAZORPAY_KEY_ID/SECRET,
# RAZORPAY_WEBHOOK_SECRET, CLIENT_URL. The server refuses to start otherwise (see src/config/env.js).
MONGODB_URI=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=
RAZORPAY_KEY_ID=    
RAZORPAY_KEY_SECRET=
# Set the same secret in Razorpay Dashboard > Webhooks (events: payment.captured, order.paid, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=
# Comma-separated exact origins allowed by CORS
CLIENT_URL=
# Max ms to wait for in-flight requests on SIGTERM
SHUTDOWN_TIMEOUT_MS=

# Rate limiting (per 15 min by default). Signed-in users are counted by user id, anonymous callers by IP.
# RATE_LIMIT_USER_MAX=600
# RATE_LIMIT_IP_MAX=300
# RATE_LIMIT_WINDOW_MS=900000
